# ============================================================
# 云部署环境变量模板
# 用法：cp .env.cloud.example .env 后填写真实值，勿提交 .env
# docker compose up -d --build
# ============================================================

# 对外域名与端口（前端容器映射到宿主 WEB_PORT；80 端口需 root 权限）
DOMAIN=your-domain.com
WEB_PORT=80
CORS_ORIGINS=https://your-domain.com

# PostgreSQL（compose 内自动创建库并启用 pgvector）
POSTGRES_USER=jbgs
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=jbgs

# 后端
SECRET_KEY=change-me-to-a-long-random-string
DEMO_MODE=false

# AI 提供方
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# RAG
RAG_PROVIDER=auto
EMBEDDING_PROVIDER=auto
RAG_SEARCH_MODE=hybrid
RAG_GROUNDING_THRESHOLD=0.05
RAG_SEMANTIC_THRESHOLD=0.35

# 判题：Docker 沙箱（默认）；如接 CodeCrucible 远程集群改为 codecrucible
JUDGE_PROVIDER=docker
JUDGE_DOCKER_IMAGE_PYTHON=python:3.11-slim
JUDGE_DOCKER_IMAGE_C=gcc:13
JUDGE_DOCKER_IMAGE_CPP=gcc:13
JUDGE_DOCKER_IMAGE_JAVA=eclipse-temurin:17-jdk
JUDGE_ALLOW_UNSAFE_LOCAL=false

# OCR / 结构化解析
OCR_PROVIDER=auto
PDF_OCR_ENABLED=true
MAX_UPLOAD_MB=200

# 多模态视觉（可选，预留）
VISION_PROVIDER=mock
GLM4V_API_KEY=
QWEN_VL_API_KEY=
