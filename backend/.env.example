# 应用
APP_NAME=星计知研 · 教学研一体化智能平台
DEBUG_MODE=true
DATABASE_URL=postgresql+psycopg://jbgs@127.0.0.1:5433/jbgs
SECRET_KEY=change-me-in-production
DEMO_MODE=true

# AI 模块提供方：mock | deepseek
LLM_PROVIDER=mock
RAG_PROVIDER=mock
JUDGE_PROVIDER=mock

# Docker 沙箱判题（JUDGE_PROVIDER=docker，推荐生产/比赛演示）：
# 一次性容器：--network none（断网）+ --read-only（只读根文件系统）
# + --memory/--cpus/--pids-limit（资源硬限制），结束自动删除
JUDGE_DOCKER_IMAGE_PYTHON=python:3.11-slim
JUDGE_DOCKER_IMAGE_C=gcc:13
JUDGE_DOCKER_IMAGE_CPP=gcc:13
JUDGE_DOCKER_IMAGE_JAVA=eclipse-temurin:17-jdk
JUDGE_DOCKER_CPUS=1.0
JUDGE_DOCKER_PIDS_LIMIT=64
JUDGE_DOCKER_GLOBAL_TIMEOUT_S=300

# CodeCrucible 判题接入（JUDGE_PROVIDER=codecrucible）
# 本地模式：复用 CodeCrucible 判题语义在本机执行；生产建议接远程集群
# CODECRUCIBLE_BASE_URL=http://localhost:8001
# CODECRUCIBLE_AUTH_TOKEN=
# CODECRUCIBLE_JWT_SECRET=
# CODECRUCIBLE_PROBLEM_ID=
# JUDGE_TIME_LIMIT_MS=1000
# JUDGE_MEMORY_LIMIT_KB=262144
# JUDGE_ALLOW_UNSAFE_LOCAL=true
# 多模态：视觉（mock | glm4v | qwen_vl）与语音（ASR/TTS，当前仅 mock）
VISION_PROVIDER=mock
ASR_PROVIDER=mock
TTS_PROVIDER=mock

# RAG 真实化：Embedding 提供方（auto=优先 fastembed，否则哈希兜底）与检索模式
# hash | fastembed | auto
EMBEDDING_PROVIDER=auto
# hybrid=词法+语义混合检索（需真实 Embedding）；lexical=纯词法（哈希可用）
RAG_SEARCH_MODE=hybrid
# RAG 判定“命中知识库”的最低相似度（低于该值则回退为模型自身知识回答）
# 词法尺度阈值：RAG_GROUNDING_THRESHOLD=0.05（纯词法模式生效）
# 语义尺度阈值：RAG_SEMANTIC_THRESHOLD=0.35（混合/语义模式生效）
RAG_GROUNDING_THRESHOLD=0.05
RAG_SEMANTIC_THRESHOLD=0.35

# 知识库上传大小上限（MB）。188MB 级整本教材 PDF 请保持默认 200；
# 超过该限制时请先拆分章节或使用目录扫描导入。
MAX_UPLOAD_MB=200

# 批量导入目录（教材 PDF/txt 放这里，在“知识库管理 → 批量导入”一键扫描入库）
KNOWLEDGE_FILES_DIR=

# 扫描版 PDF 自动 OCR（需 pip install pymupdf rapidocr_onnxruntime）
PDF_OCR_ENABLED=true

# OCR Provider：auto | rapid | paddle | mock
# rapid=RapidOCR（ONNX 离线）；paddle=PaddleOCR（需安装 paddleocr）；
# auto=优先 rapid，不可用时回退 mock；mock=确定性伪 OCR（演示/测试）
OCR_PROVIDER=auto

# 复杂教材结构化解析依赖（可选）：
#   pip install -r requirements-ocr.txt
# 包含 rapid_layout（版面）、rapid_table（表格）、pdfplumber（文字层表格）、
# rapidocr_onnxruntime（OCR）；公式识别 RapidLaTeXOCR 需从 GitHub 源码安装。

# DeepSeek（接入真实 LLM 时填写，切勿提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 多模态视觉（预留）：智谱 GLM-4V / 通义千问 Qwen-VL（OpenAI 兼容接口）
GLM4V_API_KEY=
GLM4V_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM4V_MODEL=glm-4v-flash
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
